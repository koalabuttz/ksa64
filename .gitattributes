# Canonical source and generated evidence use LF on every host.
*.json text eol=lf
# Phase 8 froze this provenance source by exact raw-byte hash before the
# repository-wide LF rule existed. Preserve those accepted mixed-ending bytes.
phase8/source-data/firestorm54-spatial.json -text -diff
# Phase 10 likewise binds its vehicle source by accepted raw-byte CRC/SHA.
phase10/source-data/ksa-g10r-source.json -text -diff
*.rs text eol=lf
*.sha256 text eol=lf
*.csv text eol=lf
*.html text eol=lf

# Keep reviewable Unreal project and plugin source stable across Windows hosts.
foundry/**/*.uproject text eol=lf
foundry/**/*.uplugin text eol=lf
foundry/**/*.ini text eol=lf
foundry/**/*.cs text eol=lf
foundry/**/*.cpp text eol=lf
foundry/**/*.h text eol=lf
foundry/**/*.md text eol=lf
viewer-bridge/**/*.h text eol=lf
phase12/**/*.md text eol=lf
phase12/**/*.toml text eol=lf
phase12/**/*.ps1 text eol=lf

# Unreal authored binary assets and portable asset masters are versioned via
# Git LFS. Generated engine output is ignored in .gitignore.
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap filter=lfs diff=lfs merge=lfs -text lockable
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
